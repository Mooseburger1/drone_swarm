<?xml version="1.0"?>
<robot name="quadrotor">


  <!-- Materials -->
  <material name="dark_grey">
    <color rgba="0.22 0.24 0.27 1.0"/>
  </material>


  <material name="arm_grey">
    <color rgba="0.45 0.48 0.52 1.0"/>
  </material>


  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>


  <material name="rotor_green">
    <color rgba="0.0 0.85 0.25 0.85"/>
  </material>


  <material name="rotor_blue">
    <color rgba="0.1 0.45 0.95 0.85"/>
  </material>


  <!-- Central Body Hub: 0.20m x 0.20m x 0.06m -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.20 0.20 0.06"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>


  <!-- Front Nose Indicator (+X direction) -->
  <link name="front_marker">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.03 0.06 0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>


  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_marker"/>
    <origin xyz="0.105 0.0 0.01" rpy="0.0 0.0 0.0"/>
  </joint>


  <!-- 4 Symmetric Arms (0.22m length from center at +/-45 deg and +/-135 deg) -->
  <link name="arm_fl">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.22 0.025 0.02"/>
      </geometry>
      <material name="arm_grey"/>
    </visual>
  </link>


  <joint name="arm_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_fl"/>
    <origin xyz="0.07778 0.07778 0.0" rpy="0.0 0.0 0.785398"/>
  </joint>


  <link name="arm_fr">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.22 0.025 0.02"/>
      </geometry>
      <material name="arm_grey"/>
    </visual>
  </link>


  <joint name="arm_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_fr"/>
    <origin xyz="0.07778 -0.07778 0.0" rpy="0.0 0.0 -0.785398"/>
  </joint>


  <link name="arm_bl">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.22 0.025 0.02"/>
      </geometry>
      <material name="arm_grey"/>
    </visual>
  </link>


  <joint name="arm_bl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_bl"/>
    <origin xyz="-0.07778 0.07778 0.0" rpy="0.0 0.0 2.356194"/>
  </joint>


  <link name="arm_br">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.22 0.025 0.02"/>
      </geometry>
      <material name="arm_grey"/>
    </visual>
  </link>


  <joint name="arm_br_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_br"/>
    <origin xyz="-0.07778 -0.07778 0.0" rpy="0.0 0.0 -2.356194"/>
  </joint>


  <!-- 4 Spinning Rotors (Continuous Joints at 0.22m radius from center) -->
  <!-- Front-Left Rotor (Green) -->
  <link name="rotor_fl">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
      <material name="rotor_green"/>
    </visual>
  </link>


  <joint name="rotor_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_fl"/>
    <origin xyz="0.15556 0.15556 0.02" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- Front-Right Rotor (Green) -->
  <link name="rotor_fr">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
      <material name="rotor_green"/>
    </visual>
  </link>


  <joint name="rotor_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_fr"/>
    <origin xyz="0.15556 -0.15556 0.02" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- Back-Left Rotor (Blue) -->
  <link name="rotor_bl">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
      <material name="rotor_blue"/>
    </visual>
  </link>


  <joint name="rotor_bl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_bl"/>
    <origin xyz="-0.15556 0.15556 0.02" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- Back-Right Rotor (Blue) -->
  <link name="rotor_br">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
      <material name="rotor_blue"/>
    </visual>
  </link>


  <joint name="rotor_br_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_br"/>
    <origin xyz="-0.15556 -0.15556 0.02" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
  </joint>


</robot>